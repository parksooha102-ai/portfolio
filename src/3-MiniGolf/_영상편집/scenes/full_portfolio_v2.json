 "subtitles": [
  {
   "id": "s1",
   "start": 4.1,
   "end": 7.9,
   "text": "【조준 → 샷】 공을 당겨 방향과 세기를 정하고, 놓아서 친다",
   "style": "설명"
  },
  {
   "id": "s2",
   "start": 8.1,
   "end": 11.2,
   "text": "【홀인 → 판정】 타수를 Par와 비교해 CLEAR · PAR / BOGEY",
   "style": "설명"
  },
  {
   "id": "s3",
   "start": 11.4,
   "end": 14.2,
   "text": "【드래그】 당긴 반대 방향으로 발사 — 당긴 거리가 세기",
   "style": "설명"
  },
  {
   "id": "s4",
   "start": 14.4,
   "end": 17.2,
   "text": "【우클릭 드래그】 카메라를 돌려 코스를 살핀다",
   "style": "설명"
  },
  {
   "id": "s5",
   "start": 17.4,
   "end": 19.8,
   "text": "【드래그 중 휠】 타점(피치)을 5°씩 올려 띄워 친다",
   "style": "설명"
  },
  {
   "id": "s6",
   "start": 20,
   "end": 22.8,
   "text": "【1-1】 조작 익히기 · 쿠션 벽  ·  Par 4",
   "style": "설명"
  },
  {
   "id": "s7",
   "start": 23,
   "end": 25.8,
   "text": "【1-2】 물 (해저드)  ·  Par 4",
   "style": "설명"
  },
  {
   "id": "s8",
   "start": 26,
   "end": 28.8,
   "text": "【1-3】 부스트 패드  ·  Par 3",
   "style": "설명"
  },
  {
   "id": "s9",
   "start": 29,
   "end": 31.8,
   "text": "【1-4】 셔틀 벽  ·  Par 3",
   "style": "설명"
  },
  {
   "id": "s10",
   "start": 32,
   "end": 34.8,
   "text": "【1-5】 풍차  ·  Par 5",
   "style": "설명"
  },
  {
   "id": "s11",
   "start": 35,
   "end": 37.8,
   "text": "【1-6】 월드 1 종합 — 부스트 · 셔틀 · 풍차 · 물  ·  Par 6",
   "style": "설명"
  },
  {
   "id": "s12",
   "start": 38,
   "end": 42,
   "text": "【타점 없이】 굴려 치면 높은 그린에 오르지 못하고 돌아온다",
   "style": "설명"
  },
  {
   "id": "s13",
   "start": 42.2,
   "end": 45.4,
   "text": "【타점 올리기】 드래그하면서 휠로 띄워 치는 각도를 올린다",
   "style": "설명"
  },
  {
   "id": "s14",
   "start": 45.6,
   "end": 50.6,
   "text": "【물 넘기】 띄운 공이 물을 넘어 높은 그린에 올라간다",
   "style": "설명"
  },
  {
   "id": "s15",
   "start": 50.8,
   "end": 54.8,
   "text": "【쿠션 벽】 벽을 맞혀 꺾어 보낼 수 있나? — 반사각",
   "style": "설명"
  },
  {
   "id": "s16",
   "start": 55,
   "end": 59.5,
   "text": "【부스트 패드】 패드 방향을 이용할까, 피할까? — 경로 선택",
   "style": "설명"
  },
  {
   "id": "s17",
   "start": 59.7,
   "end": 63.5,
   "text": "【셔틀 벽】 언제 칠까? — 타이밍",
   "style": "설명"
  },
  {
   "id": "s18",
   "start": 63.7,
   "end": 68.5,
   "text": "【풍차】 날개 사이로 지나갈 수 있나? — 타이밍 + 정확도",
   "style": "설명"
  },
  {
   "id": "s19",
   "start": 68.7,
   "end": 70.8,
   "text": "【물에 빠지면】 부스트 패드에 밀려 물로 떨어져도",
   "style": "설명"
  },
  {
   "id": "s20",
   "start": 71,
   "end": 73,
   "text": "【직전 샷 위치로】 마지막으로 직접 친 자리로 돌아온다 — 벌타 없이 STROKE 1 그대로",
   "style": "설명"
  },
  {
   "id": "s21",
   "start": 73.2,
   "end": 77,
   "text": "【움직이는 장애물】 셔틀 벽은 MovePosition으로 움직여, 부딪힌 결과를 예측할 수 있다",
   "style": "설명"
  },
  {
   "id": "s22",
   "start": 77.2,
   "end": 81,
   "text": "【2-6 월드 2 종합】 부스트 · 셔틀 · 풍차 · 물을 한 홀에서  ·  Par 6",
   "style": "설명"
  },
  {
   "id": "s23",
   "start": 81.2,
   "end": 85.5,
   "text": "【셔틀 벽】 풍차 앞을 오가는 벽 사이로 타이밍을 본다",
   "style": "설명"
  },
  {
   "id": "s24",
   "start": 85.7,
   "end": 93,
   "text": "【부스트 + 풍차】 패드에 실려 풍차 날개 사이로",
   "style": "설명"
  },
  {
   "id": "s25",
   "start": 93.2,
   "end": 99.8,
   "text": "【홀인】 7타 BOGEY — 월드 2 클리어",
   "style": "설명"
  }
 ],
