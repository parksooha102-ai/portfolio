 "subtitles": [
  {
   "id": "s0",
   "start": 4.55,
   "end": 8.25,
   "text": "【마을】 임무 목록에서 상대할 보스를 고른다",
   "style": "자막"
  },
  {
   "id": "s1",
   "start": 8.45,
   "end": 11.75,
   "text": "【장착】 증강칩을 그리드에 끼워 장착한다",
   "style": "자막"
  },
  {
   "id": "s2",
   "start": 19.45,
   "end": 25.75,
   "text": "【처치】 차르카로사우루스",
   "style": "자막"
  },
  {
   "id": "s3",
   "start": 25.95,
   "end": 29.75,
   "text": "【보상】 임무 완료 — 증강칩 6개 획득",
   "style": "자막"
  },
  {
   "id": "s4",
   "start": 29.95,
   "end": 33.25,
   "text": "【정비】 장착한 스킬 칩을 빠르게 해제하고",
   "style": "자막"
  },
  {
   "id": "s5",
   "start": 33.45,
   "end": 37.25,
   "text": "【정비】 새로 얻은 칩으로 다시 장착한다",
   "style": "자막"
  },
  {
   "id": "s6",
   "start": 37.65,
   "end": 41.75,
   "text": "【다음 임무】 더 강한 보스에 도전한다",
   "style": "자막"
  },
  {
   "id": "s7",
   "start": 61.15,
   "end": 65.25,
   "text": "【칩 지급】 시연용 디스펜서 하나로 증강칩 28종 획득",
   "style": "자막"
  },
  {
   "id": "s8",
   "start": 65.55,
   "end": 73.25,
   "text": "【장착】 염동 투사 → 1번, 염동 충격파 → 2번 — 가장 앞 빈 슬롯으로",
   "style": "자막"
  },
  {
   "id": "s9",
   "start": 73.4,
   "end": 77.7,
   "text": "【슬롯 순서】 끌어서 1번 ↔ 2번을 바꾼다",
   "style": "자막"
  },
  {
   "id": "s10",
   "start": 77.9,
   "end": 82.2,
   "text": "【장착 제한】 슬롯 5칸이 다 차면 6번째 스킬 칩은 경고",
   "style": "자막"
  },
  {
   "id": "s11",
   "start": 89.5,
   "end": 95.4,
   "text": "【같은 칩 2장】 아드레날린 과분비 두 장, 모양이 서로 다르다",
   "style": "자막"
  },
  {
   "id": "s12",
   "start": 95.6,
   "end": 101.3,
   "text": "【파밍】 더 잘 맞는 모양을 다시 얻으려는 반복 도전의 동기",
   "style": "자막"
  },
  {
   "id": "s13",
   "start": 101.5,
   "end": 106.7,
   "text": "【쿨타임】 슬롯마다 남은 시간이 줄어든다 — 충격파 9 → 6",
   "style": "자막"
  },
  {
   "id": "s14",
   "start": 106.9,
   "end": 111.8,
   "text": "【쿨타임 당김】 투사가 적중하자 충격파 쿨타임 6 → 4\n\"남은 시간\"으로 들고 있어 당기는 효과도 한 줄",
   "style": "자막"
  },
  {
   "id": "s15",
   "start": 112,
   "end": 114.8,
   "text": "【염동 충격파】",
   "style": "자막"
  },
  {
   "id": "s16",
   "start": 114.9,
   "end": 118.5,
   "text": "【수동 회피】 구르기 무적으로 피하면 하얀 허물",
   "style": "자막"
  },
  {
   "id": "s17",
   "start": 118.6,
   "end": 120.8,
   "text": "【자동 회피】 조건 반사 칩이 대신 피하면 파란 잔상",
   "style": "자막"
  },
  {
   "id": "s18",
   "start": 121,
   "end": 124.8,
   "text": "【분류 필터】 공격 칩만 (빨강)",
   "style": "자막"
  },
  {
   "id": "s19",
   "start": 125,
   "end": 128.8,
   "text": "【분류 필터】 유틸 칩만 (노랑) — 계열마다 칩 색이 다르다",
   "style": "자막"
  }
 ],
