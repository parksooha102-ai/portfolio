 "subtitles": [
  {
   "id": "s0",
   "start": 4.55,
   "end": 8.25,
   "text": "【마을】 임무 목록에서 상대할 보스를 고른다",
   "style": "설명"
  },
  {
   "id": "s1",
   "start": 8.45,
   "end": 11.75,
   "text": "【장착】 증강칩을 그리드에 끼워 장착한다",
   "style": "설명"
  },
  {
   "id": "s2",
   "start": 19.45,
   "end": 25.75,
   "text": "【처치】 보스를 쓰러뜨리면 임무 완료",
   "style": "설명"
  },
  {
   "id": "s3",
   "start": 25.95,
   "end": 29.75,
   "text": "【보상】 임무 완료 — 증강칩 6개 획득",
   "style": "설명"
  },
  {
   "id": "s4",
   "start": 29.95,
   "end": 33.25,
   "text": "【정비】 장착한 스킬 칩을 빠르게 해제하고",
   "style": "설명"
  },
  {
   "id": "s5",
   "start": 33.45,
   "end": 37.25,
   "text": "【정비】 새로 얻은 칩으로 다시 장착한다",
   "style": "설명"
  },
  {
   "id": "s6",
   "start": 37.65,
   "end": 41.75,
   "text": "【다음 임무】 더 강한 보스에 도전한다",
   "style": "설명"
  },
  {
   "id": "s7",
   "start": 61.15,
   "end": 65.25,
   "text": "【칩 지급】 시연용 디스펜서 하나로 증강칩 28종 획득",
   "style": "설명"
  },
  {
   "id": "s8",
   "start": 65.55,
   "end": 73.25,
   "text": "【장착】 염동 투사 → 1번, 염동 충격파 → 2번 — 가장 앞 빈 슬롯으로",
   "style": "설명"
  },
  {
   "id": "s9",
   "start": 73.4,
   "end": 77.7,
   "text": "【슬롯 순서】 끌어서 1번 ↔ 2번을 바꾼다",
   "style": "설명"
  },
  {
   "id": "s10",
   "start": 77.9,
   "end": 80.3,
   "text": "【장착 제한】 슬롯 5칸이 다 차면 6번째 스킬 칩은 경고",
   "style": "설명"
  },
  {
   "id": "s11",
   "start": 80.4,
   "end": 83.2,
   "text": "【칸 수 = CellCount】 아드레날린 6칸 · 보호막 4칸 · 회복 3칸 — 표 그대로",
   "style": "설명"
  },
  {
   "id": "s12",
   "start": 83.4,
   "end": 90.2,
   "text": "【능력치 칩 10종 = 표 10행】 모두 2~3칸 · 장착하면 기본값 + Value",
   "style": "설명"
  }
 ],
