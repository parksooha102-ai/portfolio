 "subtitles": [
  {
   "id": "s0",
   "start": 5.2,
   "end": 8.9,
   "text": "【마을】 임무 목록에서 상대할 보스를 고른다",
   "style": "설명"
  },
  {
   "id": "s1",
   "start": 9.3,
   "end": 13.4,
   "text": "【칩 획득】 시연용 디스펜서로 증강칩 28종을 받는다",
   "style": "설명"
  },
  {
   "id": "s2",
   "start": 13.7,
   "end": 17.4,
   "text": "【증강칩 패널】 6×6 그리드에 칩을 끼운다\n능력치 칩 10종 · 스킬 칩 18종",
   "style": "설명"
  },
  {
   "id": "s3",
   "start": 17.7,
   "end": 21.4,
   "text": "【분류 필터】 공격 · 방어 · 유틸 · 패시브 · 스탯",
   "style": "설명"
  },
  {
   "id": "s4",
   "start": 21.7,
   "end": 30.3,
   "text": "【장착】 스킬 칩은 1~5번 슬롯 중\n가장 앞 빈 슬롯에 들어간다",
   "style": "설명"
  },
  {
   "id": "s5",
   "start": 30.5,
   "end": 34.9,
   "text": "【슬롯 순서】 슬롯을 끌어 순서를 바꾼다",
   "style": "설명"
  },
  {
   "id": "s6",
   "start": 35.2,
   "end": 39.4,
   "text": "【장착 제한】 스킬 슬롯은 5칸 — 6번째 스킬 칩은 끼울 수 없다",
   "style": "설명"
  },
  {
   "id": "s7",
   "start": 39.7,
   "end": 46.4,
   "text": "【능력치 칩】 장착하는 동안 공격력 · 체력 등 스탯을 올린다",
   "style": "설명"
  },
  {
   "id": "s8",
   "start": 46.7,
   "end": 53.4,
   "text": "【훈련 구역】 숫자키 1~5로 슬롯의 스킬을 발동한다",
   "style": "설명"
  },
  {
   "id": "s9",
   "start": 53.6,
   "end": 58.9,
   "text": "【쿨타임 당김】 아드레날린 과분비: 피해를 주면 쿨타임이 줄어든다\n쿨타임을 \"남은 시간\"으로 들고 있어 한 줄로 붙은 효과",
   "style": "설명"
  },
  {
   "id": "s10",
   "start": 59.1,
   "end": 62.5,
   "text": "【아레나】 임무를 수락하고 포털로 이동한다",
   "style": "설명"
  },
  {
   "id": "s11",
   "start": 64.6,
   "end": 68.4,
   "text": "【염동 투사】",
   "style": "설명"
  },
  {
   "id": "s12",
   "start": 68.6,
   "end": 71.4,
   "text": "【염동 충격파】",
   "style": "설명"
  },
  {
   "id": "s13",
   "start": 71.5,
   "end": 75.1,
   "text": "【수동 회피】 구르기 무적으로 피하면 하얀 허물",
   "style": "설명"
  },
  {
   "id": "s14",
   "start": 75.2,
   "end": 77.4,
   "text": "【자동 회피】 조건 반사 칩이 대신 피하면 파란 잔상",
   "style": "설명"
  },
  {
   "id": "s15",
   "start": 77.6,
   "end": 80.4,
   "text": "【회복】",
   "style": "설명"
  },
  {
   "id": "s16",
   "start": 80.6,
   "end": 85.4,
   "text": "【기본 염동력】 물체를 들어 던진다",
   "style": "설명"
  },
  {
   "id": "s17",
   "start": 85.6,
   "end": 91.4,
   "text": "【염동 투사 · 염동 충격파】",
   "style": "설명"
  },
  {
   "id": "s18",
   "start": 91.7,
   "end": 100.9,
   "text": "【처치】 카르카로사우루스",
   "style": "설명"
  },
  {
   "id": "s19",
   "start": 101.1,
   "end": 105.9,
   "text": "【보상】 임무 완료 — 증강칩 6개 획득",
   "style": "설명"
  },
  {
   "id": "s20",
   "start": 106.1,
   "end": 112.4,
   "text": "【재정비】 장착한 스킬 칩을 빠르게 해제한다",
   "style": "설명"
  },
  {
   "id": "s21",
   "start": 112.6,
   "end": 118.5,
   "text": "【같은 칩, 다른 모양】 아드레날린 과분비 2장\n같은 칩도 장마다 모양이 무작위로 정해진다",
   "style": "설명"
  },
  {
   "id": "s22",
   "start": 118.7,
   "end": 124.4,
   "text": "【같은 칩, 다른 모양】 더 잘 맞는 모양을 다시 얻으려는 파밍이\n반복 도전의 동기가 된다",
   "style": "설명"
  },
  {
   "id": "s23",
   "start": 124.6,
   "end": 136.4,
   "text": "【재장착】 염동 폭풍 · 크기 조절 · 정당한 보복",
   "style": "설명"
  },
  {
   "id": "s24",
   "start": 139.6,
   "end": 144.4,
   "text": "【염동 폭풍】",
   "style": "설명"
  },
  {
   "id": "s25",
   "start": 144.6,
   "end": 149.4,
   "text": "【크기 조절】",
   "style": "설명"
  },
  {
   "id": "s26",
   "start": 149.6,
   "end": 153.5,
   "text": "【염동 폭풍】",
   "style": "설명"
  },
  {
   "id": "s27",
   "start": 153.5,
   "end": 158.4,
   "text": "【염동 폭풍】",
   "style": "설명"
  }
 ],
