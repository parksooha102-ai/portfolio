  }
 ],
 "subtitles": [
  {
   "id": "s0",
   "start": 4.55,
   "end": 8.25,
   "text": "【마을】 임무 목록에서 상대할 보스를 고른다",
   "style": "설명"
  },
  {
   "id": "s1",
   "start": 8.65,
   "end": 12.75,
   "text": "【칩 획득】 시연용 디스펜서로 증강칩 28종을 받는다",
   "style": "설명"
  },
  {
   "id": "s2",
   "start": 12.95,
   "end": 16.25,
   "text": "【장착】 증강칩을 그리드에 끼워 장착한다",
   "style": "설명"
  },
  {
   "id": "s3",
   "start": 16.55,
   "end": 23.25,
   "text": "【훈련 구역】 숫자키 1~5로 슬롯의 스킬을 발동한다",
   "style": "설명"
  },
  {
   "id": "s4",
   "start": 23.4,
   "end": 30.2,
   "text": "【아레나】 임무를 수락하고 포털로 이동한다",
   "style": "설명"
  },
  {
   "id": "s5",
   "start": 36.9,
   "end": 40.7,
   "text": "【염동 투사】",
   "style": "설명"
  },
  {
   "id": "s6",
   "start": 40.9,
   "end": 43.7,
   "text": "【회복】",
   "style": "설명"
  },
  {
   "id": "s7",
   "start": 43.9,
   "end": 48.7,
   "text": "【기본 염동력】 물체를 들어 던진다",
   "style": "설명"
  },
  {
   "id": "s8",
   "start": 48.9,
   "end": 54.7,
   "text": "【염동 투사 · 염동 충격파】",
   "style": "설명"
  },
  {
   "id": "s9",
   "start": 55,
   "end": 64.2,
   "text": "【처치】 차르카로사우루스",
   "style": "설명"
  },
  {
   "id": "s10",
   "start": 64.4,
   "end": 69.2,
   "text": "【보상】 임무 완료 — 증강칩 6개 획득",
   "style": "설명"
  },
  {
   "id": "s11",
   "start": 69.4,
   "end": 75.7,
   "text": "【정비】 장착한 스킬 칩을 빠르게 해제하고",
   "style": "설명"
  },
  {
   "id": "s12",
   "start": 75.9,
   "end": 80.7,
   "text": "【정비】 새로 얻은 칩으로 다시 장착한다",
   "style": "설명"
  },
  {
   "id": "s13",
   "start": 81.6,
   "end": 85.7,
   "text": "【다음 임무】 더 강한 보스 페르데로스에 도전한다",
   "style": "설명"
  },
  {
   "id": "s14",
   "start": 93.4,
   "end": 98.2,
   "text": "【염동 폭풍】",
   "style": "설명"
  },
  {
   "id": "s15",
   "start": 98.4,
   "end": 103.2,
   "text": "【크기 조절】",
   "style": "설명"
  },
  {
   "id": "s16",
   "start": 103.4,
   "end": 107.3,
   "text": "【염동 폭풍】",
   "style": "설명"
  },
  {
   "id": "s17",
   "start": 107.3,
   "end": 112.2,
   "text": "【염동 폭풍】",
   "style": "설명"
  },
  {
   "id": "s18",
   "start": 125,
   "end": 128.7,
   "text": "【증강칩 패널】 6×6 그리드 · 능력치 칩 10종 · 스킬 칩 18종",
   "style": "설명"
  },
  {
   "id": "s19",
   "start": 129,
   "end": 132.7,
   "text": "【분류 필터】 공격 · 방어 · 유틸 · 패시브 · 스탯",
   "style": "설명"
  },
  {
   "id": "s20",
   "start": 133,
   "end": 141.6,
   "text": "【장착】 스킬 칩은 가장 앞 빈 슬롯에 들어간다",
   "style": "설명"
  },
  {
   "id": "s21",
   "start": 141.8,
   "end": 146.2,
   "text": "【슬롯 순서】 슬롯을 끌어 순서를 바꾼다",
   "style": "설명"
  },
  {
   "id": "s22",
   "start": 146.5,
   "end": 150.7,
   "text": "【장착 제한】 스킬 슬롯은 5칸 — 6번째 스킬 칩은 끼울 수 없다",
   "style": "설명"
  },
  {
   "id": "s23",
   "start": 151,
   "end": 157.7,
   "text": "【능력치 칩】 장착하는 동안 공격력 · 체력 등 스탯을 올린다",
   "style": "설명"
  },
  {
   "id": "s24",
   "start": 157.9,
   "end": 163.8,
   "text": "【같은 칩, 다른 모양】 같은 칩도 장마다 모양이 무작위",
   "style": "설명"
  },
  {
   "id": "s25",
   "start": 164,
   "end": 169.7,
   "text": "【같은 칩, 다른 모양】 더 잘 맞는 모양을 얻으려는 파밍이 반복 도전의 동기",
   "style": "설명"
  },
  {
   "id": "s26",
   "start": 169.9,
   "end": 175.2,
   "text": "【쿨타임 당김】 아드레날린 과분비: 피해를 주면 쿨타임이 줄어든다\n쿨타임을 \"남은 시간\"으로 들고 있어 한 줄로 붙은 효과",
   "style": "설명"
  },
  {
   "id": "s27",
   "start": 175.4,
   "end": 178.2,
   "text": "【염동 충격파】",
   "style": "설명"
  },
  {
   "id": "s28",
   "start": 178.3,
   "end": 181.9,
   "text": "【수동 회피】 구르기 무적으로 피하면 하얀 허물",
   "style": "설명"
  },
  {
   "id": "s29",
   "start": 182,
   "end": 184.2,
   "text": "【자동 회피】 조건 반사 칩이 대신 피하면 파란 잔상",
   "style": "설명"
  }
 ],
